# PHPStan at the highest level, as glitchr-studio/ci's workflow runs it. The baseline is empty: the
# 91 findings of the code written before 1.1 are fixed (2026-11-10). Anything PHPStan reports fails;
# nothing goes back into the baseline.
includes:
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - .
    excludePaths:
        - vendor (?)
        - docker (?)
        - Tests/Fixtures (?)
    ignoreErrors:
        # The gateway packages are optional: the bundle lists those it knows and registers the ones
        # installed (class_exists). The package's CI analyses it with omnibill/email only.
        -
            identifier: class.notFound
            path: Bridge/Symfony/OmnibillBundle.php
            reportUnmatched: false
