# The gateways' settings: copy to .env (git-ignored), fill in what you have.
# `docker compose run --rm omnibill gateways` says what is installed and configured.

# Where the gateways' checkouts are, when this core sits in the workspace
# beside them (../.. from this directory); unset, they come from GitHub.
#OMNIBILL_PLUGINS=../..

# omnibill/email: a Symfony Mailer DSN (smtp://user:pass@host:port), the sender.
MAILER_DSN=
INVOICE_FROM=

# omnibill/afnor: an approved platform's XP Z12-013 API.
PA_FLOW_URL=
PA_DIRECTORY_URL=
PA_TOKEN_URL=
PA_CLIENT_ID=
PA_CLIENT_SECRET=
PA_WEBHOOK_KEY=

# omnibill/chorus-pro: a PISTE application and a Chorus Pro technical account.
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=
CPRO_LOGIN=
CPRO_PASSWORD=
CPRO_SANDBOX=1
