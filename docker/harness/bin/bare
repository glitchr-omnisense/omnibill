#!/usr/bin/env php
<?php

/**
 * Omnibill in bare PHP: no bundle, no container, no console component. The
 * registry is built by hand from the gateway packages installed, each says
 * what it carries and does, then an invoice goes through each:
 *
 *   - email: sent to its buyer, attached (to an in-memory transport, or the
 *     MAILER_DSN given with --live), then recorded paid;
 *   - afnor: uploaded as a flow, its acknowledgement read (deposited), the
 *     inbox received (a supplier's invoice, a "paid" status), a SIREN looked
 *     up in the directory;
 *   - chorus-pro: deposited, its status read;
 *
 * the platforms answering from their packages' recorded answers - and the
 * script lists what PHP loaded on the way.
 *
 *   docker compose run --rm omnibill bare           # exits 1 when a class of a framework was loaded
 *   docker compose run --rm omnibill bare --json    # the same, whole: every class and file loaded
 *   docker compose run --rm omnibill bare --live    # the e-mail through MAILER_DSN, for real
 *
 * OMNIBILL_AUTOLOAD names another autoloader than the harness's.
 */

use Omnibill\Model\Invoice;
use Omnibill\Model\LifecycleStatus;
use Omnibill\Model\Party;
use Omnibill\Model\StatusChange;
use Omnibill\Model\Syntax;
use Omnibill\Registry;
use Omnibill\Request;
use Symfony\Component\Mailer\Mailer;
use Symfony\Component\Mailer\Transport;
use Symfony\Component\Mailer\Transport\AbstractTransport;
use Symfony\Component\Mailer\SentMessage;

require getenv('OMNIBILL_AUTOLOAD') ?: '/harness/vendor/autoload.php';

$live = in_array('--live', $argv, true);
$http = new Symfony\Component\HttpClient\MockHttpClient(require __DIR__.'/../config/recorded.php');

// The mailer (omnibill/email brings symfony/mailer): the DSN given, for real, or a transport that keeps what it is given.
$outbox = $transport = $mailer = null;
if (class_exists(Mailer::class)) {
    $outbox = new class extends AbstractTransport {
        /** @var list<Symfony\Component\Mime\Email> */
        public array $sent = [];

        protected function doSend(SentMessage $message): void
        {
            $this->sent[] = $message->getOriginalMessage();
        }

        public function __toString(): string
        {
            return 'outbox://';
        }
    };
    $dsn = getenv('MAILER_DSN') ?: '';
    $transport = $live && '' !== $dsn ? Transport::fromDsn($dsn) : $outbox;
    $mailer = new Mailer($transport);
}

$factories = [];
foreach (require __DIR__.'/../plugins.php' as [, $class]) {
    if (class_exists($class)) {
        $factories[] = str_ends_with($class, 'EmailGatewayFactory') ? new $class($mailer) : new $class($http);
    }
}
$installed = array_map(static fn ($factory) => $factory->getName(), $factories);
$config = [];
foreach (require __DIR__.'/../config/gateways.php' as $name => $gateway) {
    if (in_array($gateway['factory'], $installed, true)) {
        // Example settings for the platforms: they answer from recordings anyway.
        $config[$name] = ['factory' => $gateway['factory'], 'options' => 'email' === $name && getenv('INVOICE_FROM') ? $gateway['options'] : $gateway['example']];
    }
}
$registry = new Registry($factories, $config);

$operations = ['submit' => Request\Submit::class, 'fetch' => Request\FetchStatus::class, 'receive' => Request\Receive::class, 'set' => Request\SetStatus::class, 'lookup' => Request\Lookup::class, 'report' => Request\Report::class, 'notify' => Request\Notify::class];
$report = ['live' => $live && $outbox !== $transport, 'gateways' => []];
foreach ($registry->all() as $name => $gateway) {
    $report['gateways'][$name] = ['title' => $gateway->getTitle(), 'does' => array_keys(array_filter($operations, static fn (string $r) => $gateway->supports($r)))] + $gateway->capabilities()->toArray();
}

$invoice = new Invoice("%PDF-1.7\n% a Factur-X of the harness's\n", 'F-2026-042.pdf', Syntax::FACTURX, 'F-2026-042', new Party('Atelier Tilleul', '123456789'), new Party('Maison Érable', '702042755', email: getenv('INVOICE_TO') ?: 'compta@erable.example'), total: '1250.00');
$statuses = static fn ($flow) => array_map(static fn (StatusChange $c) => $c->status->value, $flow->history);

if ($registry->has('email')) {
    $gateway = $registry->get('email');
    $flow = $gateway->submit($invoice, 'order-42');
    $paid = $gateway->setStatus(new StatusChange(LifecycleStatus::PAID, amount: '1250.00'), $flow);
    $sent = $outbox->sent[0] ?? null;
    $report['email'] = [
        'reference' => $flow->reference,
        'status' => $flow->status?->value,
        'to' => $flow->data['to'],
        'subject' => $sent?->getSubject(),
        'attachment' => $sent ? [$sent->getAttachments()[0]->getFilename(), $sent->getAttachments()[0]->getMediaType().'/'.$sent->getAttachments()[0]->getMediaSubtype()] : null,
        'transport' => $outbox === $transport ? 'in memory' : (string) $transport,
        'history' => $statuses($gateway->fetchStatus($paid)),
    ];
}

if ($registry->has('afnor')) {
    $gateway = $registry->get('afnor');
    $flow = $gateway->submit($invoice, 'order-42');
    $acknowledged = $gateway->fetchStatus($flow);
    $inbox = $gateway->receive();
    $lines = $gateway->lookup('702042755');
    $report['afnor'] = [
        'submitted' => [$flow->reference, $flow->state->value],
        'acknowledged' => [$acknowledged->state->value, $acknowledged->status?->value],
        'received_invoices' => array_map(static fn (Invoice $i) => $i->filename, $inbox->invoices()),
        'received_statuses' => array_map(static fn (StatusChange $c) => [$c->invoiceNumber, $c->status->value], $inbox->statuses()),
        'directory' => array_map(static fn ($l) => [$l->electronicAddress, $l->platform, $l->status], $lines),
    ];
}

if ($registry->has('chorus-pro')) {
    $gateway = $registry->get('chorus-pro');
    $flow = $gateway->submit($invoice);
    $now = $gateway->fetchStatus($flow);
    $report['chorus-pro'] = ['deposited' => $flow->reference, 'status' => [$now->state->value, $now->status?->value, $now->history[0]->code ?? null]];
}

// What PHP loaded to get there: the proof that no framework was needed.
$report['symbols'] = [...get_declared_classes(), ...get_declared_interfaces(), ...get_declared_traits()];
$report['files'] = get_included_files();
$framework = array_values(preg_grep('~^(?:Symfony\\\\Component\\\\(?:DependencyInjection|Config|HttpKernel|HttpFoundation)|Symfony\\\\Bundle|Symfony\\\\Bridge|Doctrine(?!\\\\Common\\\\Lexer)|Twig)\\\\~', $report['symbols']));
$symfony = array_values(array_unique(array_map(static fn (string $s) => implode('\\', array_slice(explode('\\', $s), 0, 3)), preg_grep('~^Symfony\\\\(?!Polyfill)~', $report['symbols']))));
sort($symfony);

if (in_array('--json', $argv, true)) {
    echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE), "\n";
    exit($framework ? 1 : 0);
}

echo "Omnibill in bare PHP: the registry built by hand, no bundle, no container; the platforms' recorded answers.\n\n";
foreach ($report['gateways'] as $name => $g) {
    printf("  %-11s %s: carries %s; approved platform %s, public sector %s; does %s\n", $name, $g['title'], implode(', ', $g['syntaxes']), $g['approved'] ? 'yes' : 'no', $g['publicSector'] ? 'yes' : 'no', implode(' ', $g['does']));
}
if ($e = $report['email'] ?? null) {
    printf("\nemail: \"%s\" to %s, %s attached (%s), through %s\n  statuses: %s\n", $e['subject'], $e['to'], $e['attachment'][0] ?? '-', $e['attachment'][1] ?? '-', $e['transport'], implode(' -> ', $e['history']));
}
if ($a = $report['afnor'] ?? null) {
    printf("\nafnor: flow %s %s, then %s (%s)\n  received: %s; statuses: %s\n  directory, SIREN 702042755: %s\n", $a['submitted'][0], $a['submitted'][1], $a['acknowledged'][0], $a['acknowledged'][1], implode(', ', $a['received_invoices']), implode(', ', array_map(static fn ($s) => $s[0].' '.$s[1], $a['received_statuses'])), implode('; ', array_map(static fn ($l) => implode(' ', array_filter($l)), $a['directory'])));
}
if ($c = $report['chorus-pro'] ?? null) {
    printf("\nchorus-pro: deposited as %s; %s, %s (%s)\n", $c['deposited'], ...$c['status']);
}
echo "\nLoaded from Symfony: ", implode(', ', $symfony) ?: 'nothing', "\n";
// doctrine/lexer is no framework: a tokenizer egulias/email-validator (symfony/mime) reads addresses with.
echo 'Classes of a framework (DependencyInjection, Config, HttpKernel, HttpFoundation, a bundle or bridge, Doctrine\'s ORM or DBAL, Twig): ', $framework ? implode(', ', $framework) : 'none', "\n";
exit($framework ? 1 : 0);
